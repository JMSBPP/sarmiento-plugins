package sarmiento-plugins
version = 0.1.0
authors = "JMSBPP"
-- maintainers =
license = "BSD-3-Clause"
brief = "DeepSeek Harness plugin translating Sarmiento claims into typed Kaleckian shocks"
readme = "README.md"
homepage = "https://github.com/JMSBPP/sarmiento-plugins#readme"
sourceloc = "https://github.com/JMSBPP/sarmiento-plugins"
bugtracker = "https://github.com/JMSBPP/sarmiento-plugins/issues"

-- the Idris2 version required (e.g. langversion >= 0.5.1)
-- langversion

-- packages to add to search path
-- depends =

-- modules to install
modules = Sarmiento_plugins
        , GamsDeps.AbsPath
        , GamsDeps.GitPin
        , GamsDeps.DepsInc
        , GamsDeps.Ops
        , GamsDepsEmit

-- main file (i.e. file to load at REPL)
main = GamsDepsEmit

-- name of executable
executable = "gams-deps-emit"
